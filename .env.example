# Settings for Lab Onboarding Bot for Slack. Copy this file OUTSIDE the repository:
#   macOS/Linux: cp .env.example ~/.onboarding_bot.env && chmod 600 ~/.onboarding_bot.env
#   Windows:     copy .env.example %USERPROFILE%\.onboarding_bot.env
# (or put it anywhere and set the environment variable ONBOARDING_BOT_ENV to its path). Never commit the real file.
# Format: KEY=value, one per line, no spaces around "=", no quotes needed. Lines starting with # and empty values are
# ignored (the code default applies). Real environment variables win over this file. Every value below is a placeholder.

# --- Secrets (required) ------------------------------------------------------------------------------------------
# Slack: api.slack.com/apps > your app > OAuth & Permissions > Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Slack: Basic Information > App-Level Tokens, with the scope connections:write (starts with xapp-)
SLACK_APP_TOKEN=xapp-your-app-level-token
# Anthropic: platform.claude.com > Settings > API keys (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your-api-key
# Only for a personal (multi-workspace) API key: the workspace the requests act in. Not secret.
# ANTHROPIC_WORKSPACE_ID=wrkspc_your-workspace-id
# Only for usage_report.py: an Admin API key from an organization admin.
# ANTHROPIC_ADMIN_KEY=sk-ant-admin-your-admin-key

# --- Documents ------------------------------------------------------------------------------------------------------
# The handbook. Either a Google Doc share link (sharing: "Anyone with the link", Viewer; re-read every 10 minutes,
# pending suggestions are shown to the bot as not yet approved) ...
# DOC_URL=https://docs.google.com/document/d/<document-id>/edit?usp=sharing
# ... or a local file: .docx, .md or .txt; a relative path is next to onboarding_bot.py. Default: onboarding.docx
HANDBOOK_FILE=examples/handbook.md
# Reference-note folders (their .md/.txt files, not subfolders), separated by ";" on Windows and ":" on macOS/Linux.
# A folder named _Learned also receives the lab facts the bot learns in Slack. Relative paths: next to onboarding_bot.py.
KNOWLEDGE_DIRS=examples/notes:examples/_Learned
# Windows uses ";" between folders: KNOWLEDGE_DIRS=examples/notes;examples/_Learned

# --- Your lab (wording used in the prompts; the defaults are generic) -----------------------------------------------
# "You are the <LAB_NAME> onboarding assistant". Default: Example Lab
LAB_NAME=Example Lab
# For the message classifier: "(a <LAB_DESCRIPTION>'s Slack)". Default: university research lab
LAB_DESCRIPTION=university research lab
# Who people should ask when the documents do not cover a question (a name or a role). Default: the PI
LAB_CONTACT=the PI
# "<INSTITUTION>-wide rules are the baseline; lab and <DEPARTMENT> rules add to them". Defaults: university, department
INSTITUTION=university
DEPARTMENT=department
# Who confirms P-card and travel rules, and how to reach them. Defaults: Department Finance, and no contacts
FINANCE_NAME=Department Finance
FINANCE_CONTACTS=travel@example.edu for travel, pcard@example.edu for P-cards
# What your institution calls the account codes purchases and trips are charged to. Default: account codes
ACCOUNT_CODES=account codes
# the word before "code" in your charge codes ("project code 12345678"): such lines are not treated as secrets
CHARGE_CODE_WORD=project
# The reply when every model declines a question. Default: built from LAB_CONTACT and FINANCE_NAME
# REFUSED=Sorry, I can't answer that one. Please ask the PI, or Department Finance for P-card and travel questions.

# --- People and learning ------------------------------------------------------------------------------------------
# Slack member IDs (profile > three dots > Copy member ID) and names of the people whose lab facts are saved at once,
# comma-separated; the FIRST one approves everyone else's facts in Slack. Empty: nobody (learning needs one).
# TEACHERS=<member-id-of-the-approver>:Alex,<member-id>:Sam
# Who maintains the bot (named in answers about bot problems). Default: the lab admin
MAINTAINER=the lab admin
# Channel IDs whose posts the bot learns lasting rules from (channel details > bottom), comma-separated. Default: none
# LEARN_CHANNELS=<channel-id-of-general>
# Kill switches: LEARNING=off stops remembering, channel learning and profiles; FILES=off stops reading images and PDFs
# LEARNING=off
# FILES=off
# DM memory never reaches back before this Unix time (e.g. the day you deploy). Default: 0
# MEMORY_SINCE=0

# --- Monitoring (optional) ----------------------------------------------------------------------------------------
# A healthchecks.io-style ping URL: pinged every minute while connected to Slack, /fail when a Claude call fails.
# HEALTHCHECK_URL=https://hc-ping.com/<your-check-uuid>
